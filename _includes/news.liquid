<div class="news">
  {% if site.news != blank %}
    {% assign all_news = site.news | reverse %}
    {% assign news_size = all_news | size %}

    <!-- News Slider -->
    <div class="news-slider-wrapper" style="position: relative;">

      <!-- Prev / Next arrow buttons -->
      <button class="news-arrow news-arrow-left" onclick="newsSlide(-1)" aria-label="Previous news">&#8249;</button>
      <button class="news-arrow news-arrow-right" onclick="newsSlide(1)" aria-label="Next news">&#8250;</button>

      <!-- Slide viewport -->
      <div class="news-slider-viewport">
        <div class="news-slider-track" id="news-slider-track">
          {% for item in all_news %}
            <div class="news-slide">
              <span class="news-slide-date">{{ item.date | date: '%b %d, %Y' }}</span>
              <span class="news-slide-content">
                {% if item.inline %}
                  {{ item.content | remove: '<p>' | remove: '</p>' | emojify }}
                {% else %}
                  <a class="news-title" href="{{ item.url | relative_url }}">{{ item.title }}</a>
                {% endif %}
              </span>
            </div>
          {% endfor %}
        </div>
      </div>

      <!-- Dot indicators -->
      <div class="news-dots" id="news-dots">
        {% for item in all_news %}
          <span class="news-dot {% if forloop.first %}news-dot-active{% endif %}" onclick="newsGoTo({{ forloop.index0 }})"></span>
        {% endfor %}
      </div>
    </div>

    <style>
      .news-slider-wrapper {
        padding: 0 36px;
        user-select: none;
      }
      .news-slider-viewport {
        overflow: hidden;
        border-radius: 8px;
      }
      .news-slider-track {
        display: flex;
        transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1);
      }
      .news-slide {
        min-width: 100%;
        padding: 14px 10px 10px 10px;
        box-sizing: border-box;
        display: flex;
        flex-direction: column;
        gap: 6px;
      }
      .news-slide-date {
        font-size: 0.78rem;
        font-weight: 700;
        letter-spacing: 0.04em;
        color: var(--global-theme-color, #0075b4);
        text-transform: uppercase;
      }
      .news-slide-content {
        font-size: 0.93rem;
        line-height: 1.55;
        color: var(--global-text-color, #333);
      }
      .news-arrow {
        position: absolute;
        top: 50%;
        transform: translateY(-60%);
        background: none;
        border: none;
        font-size: 2rem;
        font-weight: 300;
        color: var(--global-theme-color, #0075b4);
        cursor: pointer;
        padding: 0 4px;
        line-height: 1;
        z-index: 2;
        opacity: 0.7;
        transition: opacity 0.2s;
      }
      .news-arrow:hover { opacity: 1; }
      .news-arrow-left  { left: 0; }
      .news-arrow-right { right: 0; }
      .news-dots {
        display: flex;
        justify-content: center;
        gap: 6px;
        margin-top: 10px;
        flex-wrap: wrap;
      }
      .news-dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: var(--global-divider-color, #ccc);
        cursor: pointer;
        transition: background 0.25s, transform 0.25s;
      }
      .news-dot-active {
        background: var(--global-theme-color, #0075b4);
        transform: scale(1.35);
      }
    </style>

    <script>
      (function() {
        var current = 0;
        var total = {{ news_size }};
        var track = document.getElementById('news-slider-track');
        var dots  = document.querySelectorAll('.news-dot');

        function goTo(n) {
          current = (n + total) % total;
          track.style.transform = 'translateX(-' + (current * 100) + '%)';
          dots.forEach(function(d, i) {
            d.classList.toggle('news-dot-active', i === current);
          });
        }

        window.newsSlide = function(dir) { goTo(current + dir); };
        window.newsGoTo  = function(n)   { goTo(n); };

        // Auto-advance every 5 seconds
        setInterval(function() { goTo(current + 1); }, 5000);
      })();
    </script>

  {% else %}
    <p>No news so far...</p>
  {% endif %}
</div>
