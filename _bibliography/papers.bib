@inproceedings{mamta-etal-2026-tinyattack,
    title = "{T}iny{A}ttack: Exploring Stylistic Vulnerabilities in Large Language Models",
    author = "., Mamta  and
      Grecu, Bogdan  and
      Cocarascu, Oana",
    booktitle = "Findings of the Association for Computational Linguistics: ACL 2026",
    year = "2026",
    publisher = "Association for Computational Linguistics",
    abstract = "Large language models (LLMs) have demonstrated remarkable capabilities across a wide range of NLP tasks. However, their robustness to stylistic variations in text remains underexplored. In this paper, we introduce TinyAttack, a framework that systematically exploits stylistic vulnerabilities in LLMs through controlled style transfer. Our approach reveals that even subtle stylistic changes can significantly alter model predictions, raising important concerns about the robustness of LLMs in real-world deployment.",
    pdf = {https://aclanthology.org/2026.findings-acl.tinyattack.pdf},
    selected={true}
}

@inproceedings{maheshwari-etal-2026-improving,
    title = "Improving Dialect Robustness in Large Language Models via {L}o{RA} and Mixture-of-Experts",
    author = "Maheshwari, Sanjh  and
      Rajpoot, Aniket Singh  and
      Cocarascu, Oana  and
      ., Mamta",
    editor = {Scherrer, Yves  and
      Aepli, No{\"e}mi  and
      Blaschke, Verena  and
      Jauhiainen, Tommi  and
      Ljube{\v{s}}i{\'c}, Nikola  and
      Nakov, Preslav  and
      Tiedemann, J{\"o}rg  and
      Zampieri, Marcos},
    booktitle = "Proceedings of the 13th Workshop on {NLP} for Similar Languages, Varieties and Dialects",
    month = mar,
    year = "2026",
    address = "Rabat, Morocco",
    publisher = "Association for Computational Linguistics",
    url = "https://aclanthology.org/2026.vardial-1.24/",
    doi = "10.18653/v1/2026.vardial-1.24",
    pages = "293--303",
    abstract = "Despite the success of large language models (LLMs) in a wide range of applications, it has been shown that their performance varies across English dialects. Differences among English dialects are reflected in vocabulary, syntax, and writing style, and can adversely affect model performance. Several studies evaluate the dialect robustness of LLMs, yet research on enhancing their robustness to dialectal variation remains limited. In this paper, we propose two parameter-efficient frameworks for improving dialectal robustness in LLMs: DialectFusion where we train separate LoRA layers for each dialect and apply different LoRA merging methods, and DialectMoE which is built on top of Mixture of Experts LoRA and introduces multiple LoRA-based experts to the feed-forward layer to internally model the dialectal dependencies. Our comprehensive analysis on five open-source LLMs for sentiment and sarcasm tasks in zero- and few-shot settings shows that our proposed approaches enhance the dialect robustness of LLMs and outperforms instruct and LoRA fine-tuning based approaches.",
    pdf = {https://aclanthology.org/2026.vardial-1.24.pdf}
}

@inproceedings{panchal-etal-2026-indic,
    title = "{I}ndic-{T}uned{L}ens: Interpreting Multilingual Models in {I}ndian Languages",
    author = "Panchal, Mihir  and
      Varshney, Deeksha  and
      ., Mamta  and
      Ekbal, Asif",
    editor = {Scherrer, Yves  and
      Aepli, No{\"e}mi  and
      Blaschke, Verena  and
      Jauhiainen, Tommi  and
      Ljube{\v{s}}i{\'c}, Nikola  and
      Nakov, Preslav  and
      Tiedemann, J{\"o}rg  and
      Zampieri, Marcos},
    booktitle = "Proceedings of the 13th Workshop on {NLP} for Similar Languages, Varieties and Dialects",
    month = mar,
    year = "2026",
    address = "Rabat, Morocco",
    publisher = "Association for Computational Linguistics",
    url = "https://aclanthology.org/2026.vardial-1.14/",
    doi = "10.18653/v1/2026.vardial-1.14",
    pages = "172--185",
    abstract = "Multilingual large language models (LLMs) are increasingly deployed in linguistically diverse regions like India, yet most interpretability tools remain tailored to English. Prior work reveals that LLMs often operate in English centric representation spaces, making cross lingual interpretability a pressing concern. We introduce Indic-TunedLens, a novel interpretability framework specifically for Indian languages that learns shared affine transformations. Unlike the standard Logit Lens, which directly decodes intermediate activations, Indic-TunedLens adjusts hidden states for each target language, aligning them with the target output distributions to enable more faithful decoding of model representations. We evaluate our framework on 10 Indian languages using the MMLU benchmark and find that it significantly improves over SOTA interpretability methods, especially for morphologically rich, low resource languages.",
    pdf = {https://aclanthology.org/2026.vardial-1.14.pdf}
}

@inproceedings{Kundalwal_2026_WACV,
    author    = {Kundalwal, Mayank Kumar and Mamta, Mamta and Mishra, Deepak and Ekbal, Asif},
    title     = {Federated Model Synchronization for Diagnostic Redefinition through a Novel Selective Parameter Unlearning},
    booktitle = {Proceedings of the IEEE/CVF Winter Conference on Applications of Computer Vision (WACV)},
    month     = {March},
    year      = {2026},
    pages     = {1395-1404},
    abstract  = {We propose a novel federated learning framework for medical image diagnosis that incorporates selective parameter unlearning. Our method enables federated model synchronization while allowing diagnostic models to selectively forget outdated or sensitive information, improving both privacy and model adaptability in clinical settings.},
    pdf       = {https://openaccess.thecvf.com/content/WACV2026/papers/Kundalwal_Federated_Model_Synchronization_WACV_2026_paper.pdf}
}

@inproceedings{mamta-cocarascu-2025-guard,
    title = "{I}-{GUARD}: Interpretability-Guided Parameter Optimization for Adversarial Defense",
    author = "Mamta  and
      Cocarascu, Oana",
    booktitle = "Findings of the Association for Computational Linguistics: EMNLP 2025",
    month = nov,
    year = "2025",
    address = "Suzhou, China",
    publisher = "Association for Computational Linguistics",
    url = "https://aclanthology.org/2025.findings-emnlp.1208/",
    doi = "10.18653/v1/2025.findings-emnlp.1208",
    pages = "22173--22188",
    ISBN = "979-8-89176-335-7",
    abstract = {We propose I-GUARD, an interpretability-guided framework for adversarial defense in NLP. By leveraging model interpretability signals to identify and optimize the most adversarially vulnerable parameters, I-GUARD achieves robust defense without sacrificing clean accuracy. Our method identifies critical parameters through gradient-based attribution and applies targeted regularization to enhance model robustness against a wide range of adversarial attacks.},
    pdf = {https://aclanthology.org/2025.findings-emnlp.1208.pdf}
}

@inproceedings{mamta-cocarascu-2025-facteval,
    title = "{F}act{E}val: Evaluating the Robustness of Fact Verification Systems in the Era of Large Language Models",
    author = "Mamta, Mamta  and
      Cocarascu, Oana",
    booktitle = "Proceedings of the 2025 Conference of the Nations of the Americas Chapter of the Association for Computational Linguistics: Human Language Technologies (Volume 1: Long Papers)",
    month = apr,
    year = "2025",
    address = "Albuquerque, New Mexico",
    publisher = "Association for Computational Linguistics",
    url = "https://aclanthology.org/2025.naacl-long.534/",
    pages = "10647--10660",
    ISBN = "979-8-89176-189-6",
    abstract = {We introduce FactEval, a comprehensive benchmark for evaluating the robustness of fact verification systems against large language models. We systematically study how LLMs can be used to generate challenging misinformation that evades state-of-the-art fact verification systems and propose evaluation protocols that better reflect real-world deployment conditions.},
    pdf = {https://aclanthology.org/2025.naacl-long.534.pdf}
}

@inproceedings{mamta2024biaswipe,
  title={BiasWipe: Mitigating Unintended Bias in Text Classifiers through Model Interpretability},
  author={Mamta, and Chigrupaatii, Rishikant and Ekbal, Asif},
  booktitle={Proceedings of the 2024 Conference on Empirical Methods in Natural Language Processing},
  pages={21059--21070},
  year={2024},
  abstract={We present BiasWipe, a model interpretability-based framework for identifying and mitigating unintended bias in text classifiers. By analyzing attribution scores to locate biased neurons and features, BiasWipe selectively suppresses biased representations while preserving task performance. Our approach demonstrates significant bias reduction across multiple datasets and demographic categories without requiring retraining.},
  pdf={https://aclanthology.org/2024.emnlp-main.1164.pdf},
  selected={true}
}

@inproceedings{mamta2024aspect,
  title={Aspect-Based Multimodal Mining: Unveiling Sentiments, Complaints, and Beyond in User-Generated Content},
  author={Mamta and Singh, Gopendra Vikram and Kori, Deepak Raju and Ekbal, Asif},
  booktitle={Proceedings of the 32nd ACM International Conference on Multimedia},
  pages={6433--6442},
  year={2024},
  abstract={We propose a multimodal framework for aspect-based opinion mining in user-generated content, jointly modeling text and visual signals to detect sentiments, complaints, and other opinion types at the aspect level. Our approach leverages cross-modal attention to align textual aspects with corresponding visual cues, enabling richer understanding of user opinions in multimedia content.},
  pdf={https://dl.acm.org/doi/pdf/10.1145/3664647.3681668},
  selected={true}
}

@article{singh2024multiseao,
  title={MultiSEAO-Mix: A Multimodal Multitask Framework for Sentiment, Emotion, Support, and Offensive Analysis in Code-Mixed Setting},
  author={Mamta, and Singh, Gopendra Vikram and Verma, Atul and Ekbal, Asif and others},
  journal={IEEE Transactions on Computational Social Systems},
  year={2024},
  publisher={IEEE},
  abstract={We propose MultiSEAO-Mix, a unified multimodal and multitask learning framework for jointly analyzing sentiment, emotion, social support, and offensive language in code-mixed social media text. By sharing representations across tasks and modalities, our framework achieves state-of-the-art results on multiple code-mixed benchmarks.},
  pdf={https://ieeexplore.ieee.org/document/10587087}
}

@article{mamta2025quality,
  title={Quality achhi hai (is good), satisfied! Towards aspect based sentiment analysis in code-mixed language},
  author={Mamta, and Ekbal, Asif},
  journal={Computer Speech and Language},
  volume={89},
  pages={101668},
  year={2024},
  publisher={Elsevier},
  abstract={We address the challenge of aspect-based sentiment analysis (ABSA) in code-mixed languages, focusing on Hindi-English (Hinglish) text. We introduce a new benchmark dataset and propose a cross-lingual transfer learning approach that adapts monolingual models to the code-mixed setting, achieving strong performance on aspect term extraction and sentiment classification.},
  pdf={https://www.sciencedirect.com/science/article/pii/S0885230824000792}
}

@article{mamtaTCSS2024,
  title={Atmosphere kamaal ka tha (was wonderful): A Multilingual Joint Learning Framework for Aspect Category Detection and Sentiment Classification},
  author={Mamta and Ekbal, Asif},
  journal={IEEE Transactions on Computational Social Systems},
  year={2024},
  abstract={We propose a multilingual joint learning framework for simultaneously performing aspect category detection and sentiment classification across multiple languages. Our model leverages cross-lingual representations and shared task-specific components to effectively transfer knowledge across languages, enabling robust aspect-level sentiment analysis in low-resource settings.},
  pdf={https://ieeexplore.ieee.org/document/10440432},
  selected={true}
}

@article{ahmad2023elevating,
  title={Elevating Code-mixed Text Handling through Auditory Information of Words},
  author={Mamta, and Ahmad, Zishan and Ekbal, Asif},
  journal={Conference on Empirical Methods in Natural Language Processing},
  year={2023},
  abstract={We propose a novel approach for code-mixed text analysis that incorporates auditory (phonetic) information of words alongside textual features. By leveraging phonetic embeddings derived from the pronunciation of words, our method better captures the acoustic characteristics of code-mixed speech, leading to improved performance on sentiment analysis and other downstream tasks.},
  pdf={https://aclanthology.org/2023.emnlp-main.1008.pdf},
  selected={true}
}

@article{mamta2023transformer,
  title={Transformer based multilingual joint learning framework for code-mixed and english sentiment analysis},
  author={Mamta and Ekbal, Asif},
  journal={Journal of Intelligent Information Systems},
  pages={1--23},
  year={2023},
  publisher={Springer},
  abstract={We present a transformer-based multilingual joint learning framework that simultaneously handles code-mixed and standard English sentiment analysis. By sharing transformer layers across language varieties and employing task-specific fine-tuning, our approach achieves competitive performance on both code-mixed and monolingual benchmarks.},
  pdf={https://link.springer.com/article/10.1007/s10844-023-00789-8}
}

@inproceedings{mamta2023service,
  title={Service is good, very good or excellent? towards aspect based sentiment intensity analysis},
  author={Mamta and Ekbal, Asif},
  booktitle={European Conference on Information Retrieval},
  pages={685--700},
  year={2023},
  organization={Springer},
  abstract={We tackle the problem of aspect-based sentiment intensity analysis, going beyond binary or ternary sentiment labels to predict fine-grained sentiment intensity scores at the aspect level. We introduce a new dataset annotated with sentiment intensity scores and propose a regression-based model that captures the degree of sentiment expressed towards specific aspects in reviews.},
  pdf={https://link.springer.com/chapter/10.1007/978-3-031-28244-7_43},
  selected={true}
}

@inproceedings{ekbal2022adversarial,
  title={Adversarial sample generation for aspect based sentiment classification},
  author={Mamta, Mamta and Ekbal, Asif},
  booktitle={Findings of the Association for Computational Linguistics: AACL-IJCNLP 2022},
  pages={478--492},
  year={2022},
  abstract={We propose an adversarial data augmentation framework for aspect-based sentiment classification. By generating targeted adversarial examples that preserve aspect mentions while altering sentiment-bearing words, we create challenging training samples that improve model robustness and generalization across domains.},
  pdf={https://aclanthology.org/2022.findings-aacl.40.pdf}
}

@article{mamta2022exploring,
  title={Exploring multi-lingual, multi-task, and adversarial learning for low-resource sentiment analysis},
  author={Mamta and Ekbal, Asif and Bhattacharyya, Pushpak},
  journal={Transactions on Asian and Low-Resource Language Information Processing},
  volume={21},
  number={5},
  pages={1--19},
  year={2022},
  publisher={ACM New York, NY},
  abstract={We explore the synergies between multilingual learning, multitask learning, and adversarial training for improving sentiment analysis in low-resource languages. Through extensive experiments, we demonstrate that combining these three paradigms consistently outperforms individual approaches, enabling effective knowledge transfer from high-resource languages to low-resource ones.},
  pdf={https://dl.acm.org/doi/10.1145/3505244}
}

@inproceedings{ekbal2020multi,
  title={Multi-domain tweet corpora for sentiment analysis: resource creation and evaluation},
  author={Mamta, Mamta, Ekbal, Asif and Bhattacharyya, Pushpak and Srivastava, Shikha and Kumar, Alka and Saha, Tista and others},
  booktitle={Proceedings of the Twelfth Language Resources and Evaluation Conference},
  pages={5046--5054},
  year={2020},
  abstract={We present a large-scale multi-domain tweet corpus for sentiment analysis covering diverse topics including politics, sports, entertainment, and technology. The corpus includes fine-grained sentiment annotations and is evaluated using multiple baseline models, providing a valuable resource for cross-domain sentiment analysis research.},
  pdf={https://aclanthology.org/2020.lrec-1.620.pdf}
}

@inproceedings{ekbal2022hindimd,
  title={HindiMD: A multi-domain corpora for low-resource sentiment analysis},
  author={Mamta, Mamta, Ekbal, Asif and Bhattacharyya, Pushpak and Saha, Tista and Kumar, Alka and Srivastava, Shikha and others},
  booktitle={Proceedings of the Thirteenth Language Resources and Evaluation Conference},
  pages={7061--7070},
  year={2022},
  abstract={We introduce HindiMD, a multi-domain sentiment analysis corpus for Hindi, covering domains such as product reviews, movie reviews, and news articles. We provide detailed annotation guidelines and baseline experiments demonstrating the challenging nature of cross-domain sentiment analysis in Hindi.},
  pdf={https://aclanthology.org/2022.lrec-1.761.pdf}
}

@inproceedings{behera2020only,
  title={Only text? only image? or both? Predicting sentiment of internet memes},
  author={Behera, Pranati and Mamta, Mamta, and Ekbal, Asif},
  booktitle={Proceedings of the 17th International Conference on Natural Language Processing (ICON)},
  pages={444--452},
  year={2020},
  abstract={We investigate the relative contribution of text and image modalities for predicting the sentiment of internet memes. Through systematic ablation studies comparing text-only, image-only, and multimodal fusion approaches, we demonstrate that both modalities are complementary and that multimodal models significantly outperform unimodal baselines for meme sentiment analysis.},
  pdf={https://aclanthology.org/2020.icon-main.51.pdf}
}
