<ul class="card-text font-weight-light list-group list-group-flush">
  {% for content in data[1] %}
    <li class="list-group-item">
      <div class="row">
        <div class="col-xs-2 cl-sm-2 col-md-2 text-center" style="width: 75px">
          {% if content.date %}
            <span class="badge font-weight-bold danger-color-dark text-uppercase align-middle" style="min-width: 75px">{{ content.date }}</span>
          {% else %}
            <span class="badge font-weight-bold danger-color-dark text-uppercase align-middle" style="min-width: 75px"></span>
          {% endif %}
        </div>
        <div class="col-xs-10 cl-sm-10 col-md-10 mt-2 mt-md-0">
          <h6 class="title font-weight-bold ml-1 ml-md-4">{{ content.role }}</h6>
          <h6 class="ml-1 ml-md-4" style="font-size: 0.95rem">
            {% if content.url %}
              <a href="{{ content.url }}" target="_blank" rel="noopener noreferrer">{{ content.description }}</a>
            {% else %}
              {{ content.description }}
            {% endif %}
          </h6>
          {% if content.location %}
            <h6 class="ml-1 ml-md-4" style="font-size: 0.95rem; font-style: italic">{{ content.location }}</h6>
          {% endif %}
        </div>
      </div>
    </li>
  {% endfor %}
</ul>
